# =============================================================================
# Production Environment Configuration for sales-ai-agent
# Copy to prod/.env and fill in real values before deploying:
#   cp prod/.env.example prod/.env
# =============================================================================

# --- Domain & TLS ---
DOMAIN=chat.genia.coop
SSL_EMAIL=admin@genia.coop

# --- Database ---
POSTGRES_PASSWORD=replace-with-strong-random-password

# --- LLM Gateway ---
LLM_API_KEY=your-gateway-api-key
LLM_BASE_URL=https://your-llm-gateway.example.com
LLM_MODEL=claude-sonnet-4-20250514
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7

# --- Database URLs (uses "postgres" hostname = docker service name) ---
SQLALCHEMY_ASYNC_URL=postgresql+asyncpg://postgres:replace-with-strong-random-password@postgres:5432/lead_magnet
DATABASE_SYNC_URL=postgresql://postgres:replace-with-strong-random-password@postgres:5432/lead_magnet

# --- Chainlit ---
CHAINLIT_PORT=8000
